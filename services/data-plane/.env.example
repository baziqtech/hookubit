# ===========================================================================
# HookuBit - DATA PLANE environment (Go, read by this service ONLY)
#
# WHAT THIS FILE IS
#   A template. It is copied to .env ONCE, on the first deploy, and never
#   again. After that the live file is the only thing that matters:
#
#       development   <repo>/services/data-plane/.env
#       production    /opt/hookubit/shared/services/data-plane/.env
#                     (symlinked into every release as
#                      <release>/services/data-plane/.env)
#
#   Editing THIS file changes nothing on a running box. Edit the live one.
#
#   THE GO BINARY DOES NOT READ .env ITSELF. It reads the process environment.
#   In production systemd's EnvironmentFile= loads this file (after the common
#   one); in development you load it yourself per shell:
#
#       set -a; source ../../.env; source .env; set +a
#
# WHAT IS NOT IN IT
#   The variables the NestJS control plane also reads - APP_ENV, DATABASE_URL,
#   ENCRYPTION_KEY, ENCRYPTION_KEY_ID, ENCRYPTION_KEYS_RETIRED, REDIS_URL,
#   LOG_LEVEL, OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAMESPACE. Those live
#   in the repository-root .env, exactly once, so the two planes cannot drift
#   apart. An ENCRYPTION_KEY copied here and later changed in one place only
#   means this worker cannot decrypt the signing secrets the control API wrote,
#   and both processes validate their own configuration happily.
#
#   Anything that already has a default in code - which here is almost
#   everything. A value restated in a template becomes a silent fill-in:
#   whatever is present here and absent from the operator's file is what they
#   get. The defaults below are in comments, deliberately inert, so this file
#   is a catalogue you can read rather than a configuration you did not choose.
#
# FORMAT RULES - BOTH PARSERS MUST AGREE, LINE FOR LINE
#   Read by systemd's EnvironmentFile= AND by `source` in a development shell.
#   Plain KEY=value only: no quotes, no $, no export, no backslash
#   continuations, no trailing comments, no leading `;` on comments. The full
#   reasoning is in the repository-root .env.example; it applies identically
#   here.
#
# ONE GO-SPECIFIC WARNING
#   internal/config's envInt/envBool/envDuration helpers fall back to the
#   DEFAULT when a value is present but unparseable, without an error. So
#   WORKER_CONCURRENCY=sixty-four runs at 64 and says nothing. Typos here are
#   silent; check a value you have just changed against the startup log lines,
#   which print what was actually loaded. (RETENTION_* is the exception and
#   errors out instead - see that section.)
# ===========================================================================


# --- Object storage for large payloads -------------------------------------
# OPTIONAL as a feature, but all four are required TOGETHER if you want it.
# With S3_BUCKET empty there is no offload: a payload at or above
# PAYLOAD_INLINE_MAX_BYTES is refused rather than stored elsewhere, and an
# oversized response body is truncated rather than kept.
#
# Any S3-compatible endpoint (AWS S3, MinIO, R2, Backblaze). Left empty because
# a localhost MinIO copied onto a server is an offload that silently fails.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Defaults: us-east-1, path-style addressing on (correct for MinIO; AWS S3 and
# R2 want S3_FORCE_PATH_STYLE=false), and a key prefix the sweep can be sure
# the platform owns. S3_PREFIX must not be empty when S3_BUCKET is set.
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=payloads

# --- Deliberate downgrades (escape hatches, both default to refusing) -------
# Endpoint delivery rate limits are enforced fleet-wide through REDIS_URL. With
# no Redis they degrade to per-replica, so a customer's configured limit is
# multiplied by the replica count. Under APP_ENV=production the worker REFUSES
# to start in that state. Default: false.
# DELIVERY_RATE_LIMIT_ALLOW_PER_REPLICA=false

# SSRF protection. Turning it off makes 127.0.0.1, 10/8, 169.254/16 and friends
# legal delivery targets, which is what the end-to-end suite needs and what a
# self-hosted install delivering to internal consumers may want. It is REFUSED
# OUTRIGHT under APP_ENV=production - every Go role exits at startup. Prefer
# EGRESS_PRIVATE_ALLOWLIST, which is comma-separated CIDRs allowed despite
# being private. Defaults: false, and an empty allowlist.
# EGRESS_ALLOW_PRIVATE_NETWORKS=false
# EGRESS_PRIVATE_ALLOWLIST=

# --- Everything below has a default in code ---------------------------------
# Listed so it can be found, NOT set. Uncomment a line only when you have
# decided its default is wrong for you.

# Ports. Defaults: ingest 8080, Prometheus metrics 9090.
# INGEST_PORT=8080
# DATA_PLANE_METRICS_PORT=9090

# Database. DATABASE_MAX_CONNECTIONS is this process's pool;
# DATABASE_STATEMENT_TIMEOUT_MS is the server-side backstop and must be at
# least the largest per-role timeout below, or it fires first and masks it.
# Defaults: 20 connections, 30000 ms.
# DATABASE_MAX_CONNECTIONS=20
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Worker (makes the outbound calls). WORKER_DB_TIMEOUT_MS is the worker's OWN
# database deadline - it used to borrow INGEST_DB_TIMEOUT_MS, so tuning ingest
# silently retuned delivery. A claimed delivery whose lease expires is
# reclaimable by another worker. Defaults: 64, 250 ms, 100, 120 s, 5000 ms,
# fifo.
# WORKER_CONCURRENCY=64
# WORKER_POLL_INTERVAL_MS=250
# WORKER_CLAIM_BATCH_SIZE=100
# DELIVERY_LEASE_SECONDS=120
# WORKER_DB_TIMEOUT_MS=5000
# CLAIM_STRATEGY=fifo

# Router (materialises one event into one delivery row per matching
# subscription). ROUTER_MAX_OUTBOX_RETRY_DURATION_MS bounds RECORDED outbox
# failure by elapsed time rather than by a count, because no count separates a
# database brownout from a row that fails every time. Defaults: 8, 100, 60 s,
# 10, 3600000 ms, 1000 subscriptions per event, 250 ms.
# ROUTER_CONCURRENCY=8
# ROUTER_BATCH_SIZE=100
# ROUTER_LEASE_SECONDS=60
# ROUTER_MAX_OUTBOX_ATTEMPTS=10
# ROUTER_MAX_OUTBOX_RETRY_DURATION_MS=3600000
# ROUTER_MAX_SUBSCRIPTIONS_PER_EVENT=1000
# OUTBOX_POLL_INTERVAL_MS=250

# Per-scope concurrency ceilings (tenant fairness; ARCHITECTURE.md 24).
# Defaults: 512, 128, 64, 16.
# MAX_CONCURRENCY_GLOBAL=512
# MAX_CONCURRENCY_PER_ORG=128
# MAX_CONCURRENCY_PER_PROJECT=64
# MAX_CONCURRENCY_PER_ENDPOINT=16

# Outbound HTTP limits (ARCHITECTURE.md 31 - never unbounded). Defaults: 2000,
# 3000, 3000, 10000, 30000 ms; 65536 bytes; 0 redirects.
# EGRESS_DNS_TIMEOUT_MS=2000
# EGRESS_CONNECT_TIMEOUT_MS=3000
# EGRESS_TLS_TIMEOUT_MS=3000
# EGRESS_RESPONSE_HEADER_TIMEOUT_MS=10000
# EGRESS_TOTAL_TIMEOUT_MS=30000
# EGRESS_MAX_RESPONSE_BYTES=65536
# EGRESS_MAX_REDIRECTS=0

# The hard ceiling on CONCURRENT connections this process opens to ONE
# destination host:port, shared by every endpoint and tenant resolving there.
# net/http BLOCKS requests over it, so a value below WORKER_CONCURRENCY
# silently overrides MAX_CONCURRENCY_PER_ENDPOINT, MAX_CONCURRENCY_PER_PROJECT
# and the delivery gate for any customer whose endpoints share a hostname -
# which is the normal shape (api.customer.com/webhooks/orders and /refunds). It
# shipped hard-coded at 16 and cost a measured 7x on the load suite's isolation
# scenario; see docs/LOAD_TESTING.md.
#
# Default 0, which means "follow WORKER_CONCURRENCY" - exactly enough for the
# pool never to queue on the transport. Set it lower only as a deliberate act
# of politeness towards a fragile consumer, knowing the queueing moves here.
# EGRESS_MAX_CONNS_PER_HOST=0

# Circuit breaker, per endpoint. Defaults: degraded at 3 consecutive failures,
# open at 5, 2 successes to close from half-open, 30000 ms base cooldown.
# BREAKER_DEGRADED_THRESHOLD=3
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_HALF_OPEN_SUCCESSES=2
# BREAKER_BASE_COOLDOWN_MS=30000

# Ingest API (ARCHITECTURE.md 25). Two independent rate-limit layers: the
# per-source one runs BEFORE the API key is looked up, because a flood of
# invalid keys otherwise costs a database round trip each and can exhaust the
# connection pool without ever authenticating. The penalty makes the limit
# generous for honest clients and cheap to enforce against key sprayers: a
# valid request costs 1 token, a failed authentication costs 20.
#
# INGEST_RATE_LIMIT is a LIVE default, not "off" - set it to 0 if you want
# rate_limit_policies rows to be the only limit in force.
#
# Defaults: 1000/2000 per key per second; 300/600 per source IP per second;
# penalty 20; 5000 ms db timeout; 30000 ms policy cache TTL.
# INGEST_RATE_LIMIT=1000
# INGEST_RATE_LIMIT_BURST=2000
# INGEST_RATE_LIMIT_WINDOW_SECONDS=1
# INGEST_SOURCE_RATE_LIMIT=300
# INGEST_SOURCE_RATE_LIMIT_BURST=600
# INGEST_SOURCE_RATE_LIMIT_WINDOW_SECONDS=1
# INGEST_SOURCE_AUTH_FAILURE_PENALTY=20
# INGEST_DB_TIMEOUT_MS=5000
# RATE_LIMIT_POLICY_CACHE_TTL_MS=30000

# The EXACT number of reverse proxies in front of the INGEST api. Never
# inferred. At 0, X-Forwarded-For is not read at all and every request appears
# to come from the immediate peer - which behind nginx means ONE shared bucket
# for the whole internet, and the pre-auth limit above stops distinguishing
# clients. At n, only the n hops nearest this process are trusted, so a client
# cannot forge its way past by prepending addresses.
#
# Default 0. Unlike the control plane's TRUST_PROXY_HOPS, which now REFUSES to
# boot unset under APP_ENV=staging or production, this one only logs a warning
# at startup - so set it explicitly. For the documented deployment
# (Cloudflare -> nginx -> ingest) the value is 2.
# INGEST_TRUSTED_PROXY_HOPS=2

# Payload handling. Payloads at or above PAYLOAD_INLINE_MAX_BYTES go to object
# storage instead of JSONB; PAYLOAD_MAX_BYTES is the hard refusal.
# MAX_STORED_RESPONSE_BYTES bounds what is kept from a consumer's response. The
# sweep reclaims orphaned objects. Defaults: 65536, 1048576, 65536, 3 attempts,
# sweep on, hourly, min age 24h, at most 1000 deletes per pass; upload and
# download timeouts from internal/payloadstore.
# PAYLOAD_INLINE_MAX_BYTES=65536
# PAYLOAD_MAX_BYTES=1048576
# MAX_STORED_RESPONSE_BYTES=65536
# PAYLOAD_STORE_MAX_ATTEMPTS=3
# PAYLOAD_SWEEP_ENABLED=true
# PAYLOAD_SWEEP_INTERVAL_MS=3600000
# PAYLOAD_SWEEP_MIN_AGE_MS=86400000
# PAYLOAD_SWEEP_MAX_DELETES=1000
# PAYLOAD_UPLOAD_TIMEOUT_MS=
# PAYLOAD_DOWNLOAD_TIMEOUT_MS=

# Redis command deadline and the shutdown readiness delay (how long this
# process keeps failing readiness before it starts draining, so the load
# balancer stops sending it work first). Defaults: 50 ms, 5000 ms.
# REDIS_TIMEOUT_MS=50
# SHUTDOWN_READINESS_DELAY_MS=5000

# Tracing, per PROCESS. There is NO fallback to the bare OTEL_SERVICE_NAME and
# OTEL_TRACES_SAMPLER_ARG in the common file, on purpose: both planes read one
# environment and these are settings two processes cannot both be right about.
# Inheriting `control-api` would make every delivery span claim to come from
# the control plane, and inheriting a ratio of 1 would record a span for every
# attempt of every delivery of every event. Defaults: data-plane, 0.05.
# DATA_PLANE_OTEL_SERVICE_NAME=data-plane
# DATA_PLANE_OTEL_TRACES_SAMPLER_ARG=0.05

# Standard OTel variables the exporter reads itself. The TRACES endpoint takes
# precedence over the common file's OTEL_EXPORTER_OTLP_ENDPOINT and is the one
# validated. Set these only if the defaults do not suit.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TIMEOUT=5000

# --- Delivery ledger retention (scheduler role) -----------------------------
# Two horizons, because the bytes and the answers live in different places.
# delivery_attempts carries two header maps and a truncated body per attempt and
# is reclaimed first; the deliveries summary row - which answers "what happened
# to this event?" - survives three times as long. Both are floored at 48h in
# code: a delivery is still live until its max_retry_duration, and attempts
# cannot outlive the delivery they belong to.
#
# This is the ONE group that does not fall back silently. A present-but-garbage
# value here is an ERROR, not a default, because a mistyped egress timeout costs
# latency while a mistyped retention horizon deletes the delivery ledger on a
# schedule nobody chose.
#
# RETENTION_MAX_DELETES_PER_RUN bounds the FIRST pass against a never-pruned
# table, so it drains over hours rather than becoming a replication-lag
# incident.
#
# Defaults: on; 90 days of deliveries, 60 of attempts; hourly; 1000 rows per
# statement, 50000 per pass, 30000 ms per statement.
# RETENTION_ENABLED=true
# RETENTION_DELIVERY_AGE_DAYS=90
# RETENTION_ATTEMPT_AGE_DAYS=60
# RETENTION_INTERVAL_MS=3600000
# RETENTION_BATCH_SIZE=1000
# RETENTION_MAX_DELETES_PER_RUN=50000
# RETENTION_BATCH_TIMEOUT_MS=30000

# ===========================================================================
# LOCAL DEVELOPMENT
#
# A verbatim copy of this file is a working configuration - every data-plane
# variable has a default - but it has no object storage and no private-network
# egress, so large payloads are refused and a receiver on 127.0.0.1 is not a
# legal endpoint. After `pnpm dev:infra`, paste this block uncommented at the
# end of your services/data-plane/.env:
#
#   S3_ENDPOINT=http://localhost:9000
#   S3_BUCKET=hookubit-payloads
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin
#   EGRESS_ALLOW_PRIVATE_NETWORKS=true
#
# EGRESS_ALLOW_PRIVATE_NETWORKS=true is what lets the end-to-end suite's local
# receiver be a delivery target. It is refused outright under
# APP_ENV=production, so it cannot follow you to a server.
#
# Then, in each shell that runs a Go role:
#
#   set -a; source ../../.env; source .env; set +a
#   go run ./cmd/webhookd all
#
# docs/LOCAL_SETUP.md walks the whole sequence.
# ===========================================================================
