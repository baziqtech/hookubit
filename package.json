{
  "name": "webhook-platform",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:infra": "docker compose -f deployments/compose/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f deployments/compose/docker-compose.dev.yml down",
    "dev:api": "pnpm --filter @webhook/control-api start:dev",
    "dev:dashboard": "pnpm --filter @webhook/dashboard dev",
    "dev:data-plane": "cd services/data-plane && go run ./cmd/webhookd all",
    "migrate": "pnpm --filter @webhook/control-api prisma:migrate",
    "migrate:deploy": "pnpm --filter @webhook/control-api prisma:deploy",
    "generate": "pnpm --filter @webhook/control-api prisma:generate",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "go:build": "cd services/data-plane && go build ./...",
    "go:test": "cd services/data-plane && go test ./...",
    "go:vet": "cd services/data-plane && go vet ./..."
  }
}
