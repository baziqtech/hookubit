# ---------------------------------------------------------------------------
# Webhook Platform - environment configuration
#
# RULE: PostgreSQL is an EXTERNAL dependency. Never assume localhost:5432 or a
# bundled `postgres` container in production. The values below are development
# defaults that match deployments/compose/docker-compose.dev.yml only.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL (source of truth; required) --------------------------------
# REQUIRES PostgreSQL 15 OR NEWER. The schema uses NULLS NOT DISTINCT unique
# indexes, which 14 and earlier cannot express; the migration refuses to run
# on an older server rather than half-applying.
# Production: point at RDS/Aurora/Cloud SQL/Neon/Supabase/self-managed.
# Recommended production topology: app -> PgBouncer -> PostgreSQL.
DATABASE_URL=postgresql://webhook:webhook@localhost:5432/webhook_platform?schema=public
# Prisma migrations must bypass PgBouncer (transaction pooling breaks DDL/prepared
# statements). Set this to a DIRECT connection when DATABASE_URL points at a pooler.
DIRECT_DATABASE_URL=postgresql://webhook:webhook@localhost:5432/webhook_platform?schema=public
DATABASE_MAX_CONNECTIONS=20

# --- Redis (cache / coordination ONLY - never durable state) ---------------
# The platform must keep working, with degraded throughput, if Redis is empty.
REDIS_URL=redis://localhost:6379/0

# --- Object storage (large payloads / large response bodies) ---------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=webhook-payloads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Payloads at or above this size go to object storage instead of JSONB.
PAYLOAD_INLINE_MAX_BYTES=65536
PAYLOAD_MAX_BYTES=1048576

# --- Secrets (generate per environment; never commit real values) ----------
# openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=
# openssl rand -base64 32  (AES-256-GCM key for endpoint signing secrets)
ENCRYPTION_KEY=

# --- Control plane (NestJS) ------------------------------------------------
CONTROL_API_PORT=3000
CONTROL_API_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies between the internet and control-api, used as
# Express's `trust proxy` hop count. It must be EXACT.
#   0  = no proxy (this file's local defaults; also the safe value when unsure)
#   1  = one ingress / load balancer in front (the Kubernetes manifests)
#   2  = CDN -> ingress
# Too low behind a proxy and every request is attributed to the proxy's own
# address, so per-IP rate limiting becomes ONE bucket for the whole platform and
# a trickle of anonymous requests locks everybody out of login. Too high (and
# `true` is unbounded) and a client can forge X-Forwarded-For to get a fresh
# bucket per request, which is no rate limiting at all.
TRUST_PROXY_HOPS=0

# --- Data plane (Go) -------------------------------------------------------
INGEST_PORT=8080
DATA_PLANE_METRICS_PORT=9090

# Worker / scheduler tuning
WORKER_CONCURRENCY=64
# The worker's own database deadline. It used to borrow INGEST_DB_TIMEOUT_MS,
# which meant tuning ingest silently retuned delivery. Must not exceed
# DATABASE_STATEMENT_TIMEOUT_MS, or the server-side backstop fires first and
# masks it.
WORKER_DB_TIMEOUT_MS=5000
# Endpoint delivery rate limits are enforced fleet-wide through REDIS_URL. With
# no Redis they degrade to per-replica, so a customer's configured limit is
# multiplied by the worker replica count. In production the worker REFUSES to
# start in that state; set this to take the downgrade deliberately.
DELIVERY_RATE_LIMIT_ALLOW_PER_REPLICA=false
WORKER_POLL_INTERVAL_MS=250
WORKER_CLAIM_BATCH_SIZE=100
# A claimed delivery whose lease expires is reclaimable by another worker.
DELIVERY_LEASE_SECONDS=120
OUTBOX_POLL_INTERVAL_MS=250
# Bounds RECORDED outbox failure by elapsed time rather than by a count: no
# count separates a database brownout from a row that fails every time.
ROUTER_MAX_OUTBOX_RETRY_DURATION_MS=3600000

# Per-scope concurrency ceilings (tenant fairness; see ARCHITECTURE.md 24)
MAX_CONCURRENCY_GLOBAL=512
MAX_CONCURRENCY_PER_ORG=128
MAX_CONCURRENCY_PER_PROJECT=64
MAX_CONCURRENCY_PER_ENDPOINT=16

# Outbound HTTP limits (see ARCHITECTURE.md 31 - never unbounded)
EGRESS_DNS_TIMEOUT_MS=2000
EGRESS_CONNECT_TIMEOUT_MS=3000
EGRESS_TLS_TIMEOUT_MS=3000
EGRESS_RESPONSE_HEADER_TIMEOUT_MS=10000
EGRESS_TOTAL_TIMEOUT_MS=30000
EGRESS_MAX_RESPONSE_BYTES=65536
EGRESS_MAX_REDIRECTS=0

# The hard ceiling on CONCURRENT connections this process opens to one
# destination host:port, shared by every endpoint and every tenant that resolves
# there. net/http BLOCKS requests over it, so a value below WORKER_CONCURRENCY
# silently overrides MAX_CONCURRENCY_PER_ENDPOINT, MAX_CONCURRENCY_PER_PROJECT
# and the delivery gate for any customer whose endpoints share a hostname -
# which is the normal shape (api.customer.com/webhooks/orders and /refunds).
# It shipped hard-coded at 16 and cost a measured 7x on the load suite's
# isolation scenario; see docs/LOAD_TESTING.md.
#
# Leave it EMPTY to default to WORKER_CONCURRENCY, which is exactly enough for
# the pool never to queue on the transport. Set it lower only as a deliberate
# act of politeness towards a fragile consumer, knowing the queueing moves here.
EGRESS_MAX_CONNS_PER_HOST=

# SSRF protection (see ARCHITECTURE.md 30). Only disable in tests.
EGRESS_ALLOW_PRIVATE_NETWORKS=false
# Comma-separated CIDRs to allow despite being private. Use only for self-hosted
# installs delivering to internal consumers on a trusted network.
EGRESS_PRIVATE_ALLOWLIST=

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=webhook-platform

# --- Bootstrap -------------------------------------------------------------
# There is NO default account. The first owner is created explicitly by
# `pnpm --filter @webhook/control-api bootstrap` or by open registration.
# See docs/adr/0006-no-default-credentials.md
#
# Self-serve signup. FALSE by default and it should stay false for any shared or
# internet-facing deployment: docs/DEVELOPMENT.md says `cp .env.example .env`, so
# whatever is written here is what an operator actually runs. With it on, anyone
# who can reach /v1/auth/register creates an account and an organization they
# own - on a multi-tenant control plane that is an open door, not a feature.
# Turn it on deliberately, per environment, when self-serve signup is the
# product decision. The first owner comes from `bootstrap` either way.
ALLOW_OPEN_REGISTRATION=false

# --- Ingest rate limiting (ARCHITECTURE.md 25) ---------------------------------
# Two independent layers. The per-source one runs BEFORE the API key is looked
# up, because a flood of invalid keys otherwise costs a database round trip
# each and can exhaust the connection pool without ever authenticating.

# Per-API-key ceiling. This is a LIVE default, not "off" - set it to 0 if you
# want rate_limit_policies rows to be the only limit in force.
INGEST_RATE_LIMIT=1000
INGEST_RATE_LIMIT_BURST=2000
INGEST_RATE_LIMIT_WINDOW_SECONDS=1

# Per-source-IP ceiling, checked before any database access. The penalty makes
# the limit generous for honest clients and cheap to enforce against key
# sprayers: a valid request costs 1 token, a failed authentication costs 20.
INGEST_SOURCE_RATE_LIMIT=300
INGEST_SOURCE_RATE_LIMIT_BURST=600
INGEST_SOURCE_RATE_LIMIT_WINDOW_SECONDS=1
INGEST_SOURCE_AUTH_FAILURE_PENALTY=20

# EXACT number of reverse proxies in front of the ingest API. Never inferred.
# At 0, X-Forwarded-For is not read at all and every request appears to come
# from the immediate peer - which behind an ingress means ONE shared bucket for
# the whole internet. At n, only the n hops nearest this process are trusted, so
# a client cannot forge its way past by prepending addresses.
INGEST_TRUSTED_PROXY_HOPS=0

# How long a rate_limit_policies row can be stale fleet-wide after an operator
# changes it. Bounded on purpose (ARCHITECTURE.md 55): there is no push
# invalidation to get wedged, and a failed refresh keeps serving the last known
# policies rather than widening to the default.
RATE_LIMIT_POLICY_CACHE_TTL_MS=30000
