# ===========================================================================
# HookuBit - COMMON environment (read by BOTH planes)
#
# WHAT THIS FILE IS
#   A template. It is copied to .env ONCE, on the first deploy, and never
#   again. After that the live file is the only thing that matters:
#
#       development   <repo>/.env
#       production    /opt/hookubit/shared/.env
#                     (symlinked into every release as <release>/.env)
#
#   Editing THIS file changes nothing on a running box. Edit the live one.
#
# WHAT GOES IN IT
#   Only the variables the NestJS control plane and the Go data plane BOTH
#   read. They live here exactly once so they cannot drift: two copies of
#   ENCRYPTION_KEY that disagree means the control API writes endpoint signing
#   secrets the worker cannot decrypt, and each process validates its own
#   configuration happily while outbound signing breaks. DATABASE_URL is the
#   same class of fault - ingest writes events the router never reads.
#
#   Everything else belongs to one service and lives with it:
#       apps/control-api/.env.example     control plane only
#       services/data-plane/.env.example  data plane only
#
# WHAT IS NOT IN IT
#   Anything that already has a default in code. A value restated here becomes
#   a silent fill-in: whatever is present in the template and absent from the
#   operator's file is what they get, so a convenient localhost default ships
#   itself to production. Defaults are mentioned in comments and nowhere else.
#   Required variables appear with EMPTY values, so validation refuses by name
#   at boot rather than starting against somebody's laptop.
#
# ---------------------------------------------------------------------------
# FORMAT RULES - BOTH PARSERS MUST AGREE, LINE FOR LINE
#
#   This file is read by dotenv (Node) AND by systemd's EnvironmentFile= (both
#   units). They are not the same language, and a line that means two
#   different things in the two parsers hands the two planes different
#   configuration out of one file.
#
#     * Plain KEY=value only. Nothing else.
#     * NO quotes. systemd strips surrounding quotes, dotenv strips them too,
#       but they disagree about escapes inside them. Leave them off.
#     * NO $ anywhere. dotenv-expand would substitute; systemd would not.
#     * NO export. dotenv accepts it, systemd puts it in the key name.
#     * NO backslash line continuations. systemd joins them, dotenv does not.
#     * NO trailing comments. `KEY=value  # note` gives dotenv `value` and
#       systemd `value  # note`. Put the comment on its own line above.
#     * NO leading `;` on a comment. systemd reads it as a comment, dotenv
#       reads it as a malformed line. Use #.
#
#   `MAIL_FROM=HookuBit <no-reply@example.com>` is safe in both and must stay
#   unquoted - that is why the rule is "no quotes" and not "quote values with
#   spaces". Angle brackets and spaces are ordinary characters to both.
#
#   apps/control-api/src/config/env-example.spec.ts parses all three example
#   files BOTH ways and diffs the results, and checks each rule above line by
#   line. It runs in `pnpm test`. Keep it passing.
# ===========================================================================


# --- Deployment identity (REQUIRED, no default) ----------------------------
# development | test | staging | production
#
# There is deliberately no default. It decides whether the session cookie
# carries Secure (off ONLY for development and test), whether a mail transport
# is mandatory, whether /docs is mounted, and - on the Go side - whether
# private-network egress and Redis-less delivery rate limits are refused. A
# default here is a guess about which machine the process woke up on, and the
# wrong guess ships session cookies over plaintext HTTP without a log line.
#
# The control plane REFUSES TO BOOT if this is missing or empty.
APP_ENV=

# --- PostgreSQL (REQUIRED, no default) -------------------------------------
# REQUIRES PostgreSQL 15 OR NEWER. The schema uses NULLS NOT DISTINCT unique
# indexes, which 14 and earlier cannot express; the migration refuses to run on
# an older server rather than half-applying.
#
# PostgreSQL is an EXTERNAL dependency. Nothing in any deployment ships one -
# point this at RDS/Aurora/Cloud SQL/Neon/Supabase/self-managed. Recommended
# production topology: app -> PgBouncer -> PostgreSQL.
#
# Left empty on purpose. A localhost value here would be copied onto a server
# and the platform would come up pointing at a database that is not theirs.
DATABASE_URL=

# --- Endpoint-secret encryption (REQUIRED, no default) ---------------------
# The AES-256-GCM key protecting endpoint signing secrets. 32 bytes,
# base64-encoded: openssl rand -base64 32
#
# BOTH planes read it and both must read the SAME value. The control plane
# encrypts with it; the Go worker decrypts to sign outbound requests.
ENCRYPTION_KEY=

# ENCRYPTION_KEY_ID names ENCRYPTION_KEY inside the ciphertext envelope so it
# can be rotated. Default in both planes: k1. Bump it whenever ENCRYPTION_KEY
# changes and move the old pair into ENCRYPTION_KEYS_RETIRED; without the id,
# rotating the key makes every endpoint_secrets row undecryptable at once.
# ENCRYPTION_KEY_ID=k1

# ENCRYPTION_KEYS_RETIRED is comma-separated <kid>:<base64key> pairs accepted
# for DECRYPTION only - the overlap that lets a rotation finish. Keep the
# previous key here until every row has been re-encrypted. Default: empty.
# ENCRYPTION_KEYS_RETIRED=

# --- Redis ------------------------------------------------------------------
# Coordination and the delivery job queue. The control plane treats it as
# genuinely optional and degrades. The Go WORKER does not: with no Redis,
# endpoint delivery rate limits fall back to per-replica, so a customer's
# configured limit is multiplied by the replica count, and under
# APP_ENV=production the worker REFUSES to start in that state. Set it, or set
# DELIVERY_RATE_LIMIT_ALLOW_PER_REPLICA=true in the data plane's own file to
# take the downgrade deliberately.
#
# Empty is read as "not configured" by both planes, so this line is safe to
# copy as-is.
REDIS_URL=

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal. Default in both planes: info.
# LOG_LEVEL=info

# --- Tracing ----------------------------------------------------------------
# The BASE OTLP/HTTP endpoint of a collector - http://otel-collector:4318, not
# .../v1/traces; the signal path is appended. UNSET IS THE OFF SWITCH: with no
# endpoint the control plane builds no exporter, no span processor and no
# tracer provider at all, so there is nothing retrying against a collector that
# does not exist.
#
# The scheme is REQUIRED and validated. otel-collector:4318 parses as a URL
# whose scheme is the hostname, so the likeliest mistake - omitting http:// -
# is refused at boot rather than exporting nothing for ever.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# OTEL_SERVICE_NAMESPACE groups this install's services in the trace backend,
# so a shared collector can carry two installs without their control-api spans
# merging. NOTE the two planes disagree when it is unset: the control plane
# defaults to `hookubit`, the Go side leaves it empty. Set it explicitly if you
# run a collector and want both planes filed together.
# OTEL_SERVICE_NAMESPACE=hookubit

# --- Per-service files ------------------------------------------------------
# Service names, sampling ratios and every tunable belong to one plane and are
# documented in that plane's own example:
#   apps/control-api/.env.example     OTEL_SERVICE_NAME, OTEL_TRACES_SAMPLER_ARG
#   services/data-plane/.env.example  DATA_PLANE_OTEL_SERVICE_NAME, ...
# They are per-PROCESS settings two processes cannot both be right about, which
# is exactly why they are not in this file.

# ===========================================================================
# LOCAL DEVELOPMENT
#
# Nothing above is set, so a verbatim copy refuses to boot - which is the point
# for a server. For a laptop, run `pnpm dev:infra` (PostgreSQL, Redis, MinIO,
# Mailpit from deployments/compose/docker-compose.dev.yml) and then paste this
# block, uncommented, at the end of your .env:
#
#   APP_ENV=development
#   LOG_LEVEL=debug
#   DATABASE_URL=postgresql://hookubit:hookubit@localhost:5432/hookubit?schema=public
#   REDIS_URL=redis://localhost:6379/0
#   ENCRYPTION_KEY=<openssl rand -base64 32>
#
# Then do the same for apps/control-api/.env and services/data-plane/.env from
# their own examples. docs/LOCAL_SETUP.md walks the whole sequence.
# ===========================================================================
