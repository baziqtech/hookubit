{
  "name": "@hookubit/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer-facing documentation for HookuBit: integrating, operating, self-hosting, and the API reference.",
  "scripts": {
    "dev": "vitepress dev --port 4000",
    "build": "node scripts/generate-api-reference.mjs && vitepress build",
    "preview": "vitepress preview --port 4000",
    "generate:api": "node scripts/generate-api-reference.mjs",
    "deploy": "pnpm build && pnpm dlx wrangler@4 deploy"
  },
  "devDependencies": {
    "@hookubit/control-api": "workspace:*",
    "mermaid": "^11.4.1",
    "vitepress": "^1.5.0",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
