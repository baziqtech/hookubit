// ---------------------------------------------------------------------------
// Webhook Platform - PostgreSQL schema
//
// Prisma owns all DDL for this database (ADR-0002). The Go data plane reads and
// writes these tables with hand-written SQL via pgx; it never runs migrations.
//
// Identifiers are prefixed, lexicographically sortable ULIDs (org_, proj_,
// evt_, del_, ep_ ...). See packages/contracts and internal/ids.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ===========================================================================
// Tenancy
// ===========================================================================

enum OrganizationStatus {
  active
  suspended
  deleted
}

model Organization {
  id        String             @id
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)
  planId    String?            @map("plan_id")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  plan                 Plan?                 @relation(fields: [planId], references: [id])
  members              OrganizationMember[]
  projects             Project[]
  auditLogs            AuditLog[]
  usageRecords         UsageRecord[]
  billingSubscriptions BillingSubscription[]
  events               Event[]

  @@map("organizations")
}

model User {
  id              String    @id
  email           String    @unique
  name            String?
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  disabledAt      DateTime? @map("disabled_at")
  /// When this person finished OR skipped the product tour. NULL means "never
  /// seen it", which is the safe direction: the tour is skippable and
  /// re-openable, so showing it once more costs a keystroke while wrongly
  /// suppressing it leaves a new user with no orientation at all. Deliberately
  /// a nullable timestamp and not a boolean - a boolean cannot answer "when",
  /// which is the question asked when a cohort churns - and not a per-step
  /// blob, which would make the tour's own layout a schema migration.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  auditLogs   AuditLog[]
  tokens      UserToken[]
  sessions    Session[]
  /// API keys this user minted. onDelete: SetNull on the key side - deleting a
  /// person must not delete the credentials they issued (that would orphan the
  /// delivery history hanging off them), and must not be blocked by them.
  apiKeysIssued ApiKey[] @relation("ApiKeyCreatedBy")

  @@map("users")
}

/// Server-side browser sessions.
///
/// The cookie is still a signed JWT, but it now carries `sid` and every
/// authenticated request checks this row. That is what makes revocation real:
/// a stateless JWT cannot be withdrawn once copied off the machine, so logout
/// was previously advisory only. Costs one indexed primary-key lookup per
/// request; the alternative (a token-version column on `users`) cannot express
/// "sign out this one device".
model Session {
  id            String    @id
  userId        String    @map("user_id")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  lastSeenAt    DateTime? @map("last_seen_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  /// logout | password_reset | admin | expired
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum UserTokenType {
  email_verification
  password_reset
  invitation
}

/// Single-use, hashed, expiring tokens. The raw token is never stored.
model UserToken {
  id         String        @id
  userId     String?       @map("user_id")
  email      String
  type       UserTokenType
  tokenHash  String        @unique @map("token_hash")
  metadata   Json?
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

enum MemberRole {
  owner
  admin
  developer
  viewer
  billing
}

model OrganizationMember {
  id             String     @id
  organizationId String     @map("organization_id")
  userId         String     @map("user_id")
  role           MemberRole
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// API keys minted while holding THIS membership. The link going NULL is the
  /// signal that the issuer has left the organization.
  apiKeysIssued ApiKey[] @relation("ApiKeyCreatedByMembership")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum Environment {
  test
  live
}

enum ProjectStatus {
  active
  suspended
  deleted
}

model Project {
  id             String        @id
  organizationId String        @map("organization_id")
  name           String
  slug           String
  environment    Environment   @default(test)
  status         ProjectStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys           ApiKey[]
  endpoints         Endpoint[]
  subscriptions     WebhookSubscription[]
  events            Event[]
  retryPolicies     RetryPolicy[]
  rateLimitPolicies RateLimitPolicy[]
  idempotencyKeys   IdempotencyKey[]

  @@unique([organizationId, slug])
  @@map("projects")
}

// ===========================================================================
// Credentials
// ===========================================================================

/// Only the hash is stored. The plaintext key is shown once, at creation.
model ApiKey {
  id         String      @id
  projectId  String      @map("project_id")
  name       String
  keyHash    String      @unique @map("key_hash")
  keyPrefix  String      @map("key_prefix")
  scopes     String[]    @default([])
  environment Environment
  expiresAt  DateTime?   @map("expires_at")
  lastUsedAt DateTime?   @map("last_used_at")
  revokedAt  DateTime?   @map("revoked_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  /// WHO MINTED THIS KEY. `scopes` is a snapshot of the issuer's authority at
  /// mint time and nothing re-checks it afterwards, so without these columns a
  /// developer who mints a key carrying `endpoints.write` and is then demoted
  /// to viewer - or removed outright - leaves a credential with full developer
  /// authority and no record of whose authority it was.
  ///
  /// Both are NULLABLE and both foreign keys are ON DELETE SET NULL. Restrict
  /// would make an issuer undeletable; Cascade would destroy the credential
  /// (and orphan its delivery history) when a person leaves. Neither is right.
  /// Pre-existing rows have no issuer and must not block the migration.
  createdByUserId       String? @map("created_by_user_id")
  /// The role lookup joins to THIS one. Its going NULL is itself the signal
  /// that the issuer has left; a NULL issuer must intersect to the empty scope
  /// set, never to the stored scopes.
  createdByMembershipId String? @map("created_by_membership_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser       User?               @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByMembership OrganizationMember? @relation("ApiKeyCreatedByMembership", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([projectId])
  /// Both indexes exist for the revocation sweep, not for reads: removing a
  /// membership must find every key that membership minted without scanning
  /// api_keys, and PostgreSQL's own ON DELETE SET NULL enforcement does the
  /// same lookup on every user/member delete.
  @@index([createdByUserId])
  @@index([createdByMembershipId])
  @@map("api_keys")
}

// ===========================================================================
// Endpoints
// ===========================================================================

enum EndpointStatus {
  active
  paused
  disabled
  deleted
}

model Endpoint {
  id             String         @id
  projectId      String         @map("project_id")
  name           String
  url            String
  description    String?
  status         EndpointStatus @default(active)
  enabled        Boolean        @default(true)
  /// Set by the circuit breaker when an endpoint is auto-disabled; a human or
  /// the half-open probe clears it. Distinct from `enabled`, which is operator intent.
  disabledReason String?        @map("disabled_reason")
  disabledAt     DateTime?      @map("disabled_at")
  timeoutMs      Int            @default(30000) @map("timeout_ms")
  maxConcurrency Int            @default(16) @map("max_concurrency")
  rateLimit      Int?           @map("rate_limit")
  rateLimitWindowSeconds Int    @default(1) @map("rate_limit_window_seconds")
  retryPolicyId  String?        @map("retry_policy_id")
  customHeaders  Json?          @map("custom_headers")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retryPolicy   RetryPolicy?          @relation(fields: [retryPolicyId], references: [id])
  secrets       EndpointSecret[]
  subscriptions WebhookSubscription[]
  deliveries    Delivery[]
  health        EndpointHealth?

  @@index([projectId])
  @@map("endpoints")
}

/// HMAC signing secrets. Encrypted at rest (AES-256-GCM, ENCRYPTION_KEY).
/// Rotation keeps the old secret active until `expiresAt`, so consumers can
/// verify against either during the overlap window (ARCHITECTURE.md 28).
model EndpointSecret {
  id              String    @id
  endpointId      String    @map("endpoint_id")
  secretEncrypted String    @map("secret_encrypted")
  version         Int
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")
  rotatedAt       DateTime? @map("rotated_at")

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, version])
  @@index([endpointId, active])
  @@map("endpoint_secrets")
}

enum EndpointHealthState {
  healthy
  degraded
  open
  half_open
}

/// Circuit-breaker state, kept out of `endpoints` so hot failure counters do not
/// contend with configuration rows read on every delivery. Redis may front this
/// for speed; PostgreSQL remains authoritative (ARCHITECTURE.md 26).
model EndpointHealth {
  endpointId          String              @id @map("endpoint_id")
  state               EndpointHealthState @default(healthy)
  consecutiveFailures Int                 @default(0) @map("consecutive_failures")
  consecutiveSuccesses Int                @default(0) @map("consecutive_successes")
  lastSuccessAt       DateTime?           @map("last_success_at")
  lastFailureAt       DateTime?           @map("last_failure_at")
  openedAt            DateTime?           @map("opened_at")
  /// When the breaker may next admit a probe request.
  probeAfter          DateTime?           @map("probe_after")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([state, probeAfter])
  @@map("endpoint_health")
}

// ===========================================================================
// Subscriptions & policies
// ===========================================================================

/// Binds an endpoint to the event types it should receive. `eventTypes` supports
/// exact matches and trailing wildcards ("payment.*", "*").
/// Filters are a core, always-on feature - never licence-gated.
model WebhookSubscription {
  id         String   @id
  projectId  String   @map("project_id")
  endpointId String   @map("endpoint_id")
  name       String?
  eventTypes String[] @default(["*"]) @map("event_types")
  /// Optional JSON predicate applied to the payload after event-type matching.
  payloadFilter Json? @map("payload_filter")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([projectId, enabled])
  @@index([endpointId])
  @@map("webhook_subscriptions")
}

model RetryPolicy {
  id           String   @id
  projectId    String   @map("project_id")
  name         String
  isDefault    Boolean  @default(false) @map("is_default")
  /// exponential | linear | constant
  strategy     String   @default("exponential")
  maxAttempts  Int      @default(8) @map("max_attempts")
  initialDelayMs Int    @default(5000) @map("initial_delay_ms")
  maxDelayMs   Int      @default(3600000) @map("max_delay_ms")
  multiplier   Float    @default(2.0)
  jitterRatio  Float    @default(0.2) @map("jitter_ratio")
  maxRetryDurationMs Int @default(86400000) @map("max_retry_duration_ms")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoints Endpoint[]

  @@index([projectId])
  /// NOTE: nine CHECK constraints and the partial unique index
  /// `retry_policies_one_default_per_project` (WHERE is_default) are created by
  /// hand in 20260907000000_handoff_schema_requests. Prisma can express
  /// neither, so they are invisible here and to `migrate diff`.
  /// The scar: `max_delay_ms = 0` overflowed int64 nanoseconds in retry.Delay
  /// and produced a NEGATIVE backoff, so next_attempt_at sat permanently in the
  /// past and a dead endpoint was re-polled every 250ms. The control plane
  /// refuses those values; the database accepted them from every other writer.
  @@map("retry_policies")
}

enum RateLimitScope {
  organization
  project
  endpoint
  ingest
}

model RateLimitPolicy {
  id            String         @id
  projectId     String         @map("project_id")
  scope         RateLimitScope
  /// Null means the policy applies to every resource in `scope`.
  resourceId    String?        @map("resource_id")
  limit         Int
  windowSeconds Int            @map("window_seconds")
  burst         Int?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Replaced in 20260906010000_review_fixes by a NULLS NOT DISTINCT index of
  /// the same name: `resourceId` NULL means "every resource in this scope", and
  /// that is precisely the row that must be unique. PostgreSQL indexes are
  /// NULLS DISTINCT by default, so the generated constraint enforced nothing on
  /// exactly the rows that mattered. Kept here so Prisma still types the
  /// compound `where` for upserts.
  /// NOTE: three CHECK constraints (limit, window_seconds, burst) are created
  /// by hand in 20260907000000_handoff_schema_requests. limit = 0 disables the
  /// covered traffic entirely, window_seconds = 0 is a division by zero in the
  /// refill rate, and burst < limit means the configured limit can never be
  /// reached. Prisma cannot express CHECK constraints.
  @@unique([projectId, scope, resourceId])
  @@map("rate_limit_policies")
}

// ===========================================================================
// Event ingestion
// ===========================================================================

enum EventStatus {
  received
  processing
  processed
  failed
}

model Event {
  id             String      @id
  organizationId String      @map("organization_id")
  projectId      String      @map("project_id")
  eventType      String      @map("event_type")
  idempotencyKey String?     @map("idempotency_key")
  /// AUTHORITATIVE PAYLOAD. The exact bytes received on the wire, byte for
  /// byte. Signing (ARCHITECTURE.md 28) and outbound delivery MUST read this
  /// column and nothing else. Null when the payload was offloaded to object
  /// storage (see payloadLocation).
  payloadRaw     Bytes?      @map("payload_raw")
  /// NON-AUTHORITATIVE. A jsonb projection of payloadRaw, for filtering,
  /// search and the operator UI only. PostgreSQL normalises jsonb - key order,
  /// insignificant whitespace and duplicate keys are not preserved - so these
  /// bytes are NOT the bytes that were received. Signing over this column
  /// produces signatures the consumer cannot verify. Never sign it, never
  /// deliver it. Section 32 mentions jsonb; section 28 governs.
  payload        Json?
  /// s3://bucket/key when the payload exceeded PAYLOAD_INLINE_MAX_BYTES.
  payloadLocation String?    @map("payload_location")
  payloadSize    Int         @map("payload_size")
  /// SHA-256 of payloadRaw (the exact raw request bytes).
  payloadHash    String      @map("payload_hash")
  /// Opt-in serialisation key carried from the ingest API (docs/API.md) onto
  /// every delivery this event fans out to. Null means unordered.
  orderingKey    String?     @map("ordering_key")
  headers        Json?
  status         EventStatus @default(received)
  createdAt      DateTime    @default(now()) @map("created_at")
  processedAt    DateTime?   @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outbox       EventOutbox[]
  deliveries   Delivery[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, eventType, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("events")
}

/// Idempotency ledger (ARCHITECTURE.md 17). `requestHash` lets a replayed key
/// with a different body be rejected as a conflict rather than silently aliased.
model IdempotencyKey {
  id          String   @id
  projectId   String   @map("project_id")
  key         String
  requestHash String   @map("request_hash")
  eventId     String?  @map("event_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

/// Transactional outbox (ARCHITECTURE.md 15). Written in the SAME transaction as
/// the event. Nothing is published to Redis before this row is committed, so an
/// ingest crash between COMMIT and publish loses time, never data.
model EventOutbox {
  id          String       @id
  eventId     String       @map("event_id")
  /// event.created | event.replay
  type        String
  status      OutboxStatus @default(pending)
  /// Total claims, MONOTONIC. Incremented by the router's claim, never lowered.
  /// This is the honest "how many times has this been picked up?" for the
  /// operator UI; it is NOT the poison bound. See `unaccountedAttempts`.
  ///
  /// "Never lowered" includes the operator requeue in `src/outbox`, which
  /// resets the two BUDGETS (`unaccountedAttempts`, `failingSince`) and leaves
  /// this column alone. A requeue that zeroed it would make the operator UI's
  /// claim count restart at zero, and the number quoted in the next park
  /// message with it - erasing exactly the history that distinguishes a row
  /// requeued four times that keeps dying from one being tried for the first
  /// time.
  attempts    Int          @default(0)
  /// THE POISON BOUND (`ROUTER_MAX_OUTBOX_ATTEMPTS`), and a different number
  /// from `attempts` on purpose.
  ///
  /// Incremented by the same claim - a row whose event kills the process never
  /// reaches a failure handler, so an increment on the failure path would let it
  /// be reclaimed and re-run forever - but DECREMENTED by every write the lease
  /// holder commits: a recorded release, or a fan-out batch that made progress.
  /// What survives is exactly "claims that ended with the router writing nothing
  /// at all", which is the crash signal and nothing else. Before the split, a
  /// degraded-Postgres window burned the whole budget on rows whose fan-out was
  /// never attempted and parked events that had already been answered 202.
  unaccountedAttempts Int   @default(0) @map("unaccounted_attempts")
  /// When this row's first RECORDED failure since the last progress happened;
  /// null when it is not currently failing. Recorded failures are bounded by
  /// ELAPSED TIME (`MaxOutboxRetryDuration`, 1h) rather than by a count, because
  /// no count distinguishes "the database was unavailable for twenty minutes"
  /// from "this row errors every time" - and time does.
  failingSince DateTime?   @map("failing_since")
  /// Resume point for a fan-out wider than one transaction: the
  /// `webhook_subscriptions.id` the last committed batch stopped at. Null means
  /// the fan-out has not started.
  ///
  /// This column is what makes `ROUTER_MAX_SUBSCRIPTIONS_PER_EVENT` a BATCH
  /// bound rather than a ceiling on the event. It used to be a ceiling: every
  /// subscription past it was dropped, the event was marked `processed` anyway,
  /// and - because ids are ULIDs and the walk is `ORDER BY s.id` - the endpoints
  /// dropped were always the newest, permanently, with no replay path (replay is
  /// built on delivery rows and they had none).
  fanOutCursor String?     @map("fan_out_cursor")
  availableAt DateTime     @default(now()) @map("available_at")
  lockedBy    String?      @map("locked_by")
  lockedUntil DateTime?    @map("locked_until")
  lastError   String?      @map("last_error")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  /// W3C `traceparent` of the INGEST request that committed this row, written
  /// inside that same transaction (ARCHITECTURE.md 44). The router reads it and
  /// LINKS its fan-out span to it - it does not become a child of it, because
  /// the fan-out happens an arbitrary time later on a different pod and a
  /// parent-child edge across that gap reports six-hour ingest latencies.
  ///
  /// A fixed 55 characters; `tracestate` is deliberately not stored. Null means
  /// tracing was off, or the row predates it: the router then starts an
  /// unlinked root, so nothing in the delivery path depends on this being set.
  traceContext String?     @map("trace_context")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  /// The tenant path for the control plane's parked-row listing and requeue
  /// (`src/outbox`). `event_outbox` carries no organization_id/project_id and
  /// must not - the router claims globally, and a denormalised tenant column on
  /// a queue table is a column that can disagree with the row it points at - so
  /// the tenancy is reached through the event, and PostgreSQL does not index a
  /// foreign key for you.
  @@index([eventId])
  /// NOTE: `event_outbox_ready_idx` - (available_at, created_at) WHERE status IN
  /// ('pending', 'processing') - is created by hand in
  /// 20260907000000_handoff_schema_requests. It covers the router's
  /// FOR UPDATE SKIP LOCKED claim ordering AND the MIN(available_at) lag gauge,
  /// neither of which the index above serves without a sort or a full scan.
  /// `processing` is in the predicate deliberately: a leased row IS processing,
  /// and a crashed router's rows must be reclaimable cheaply.
  ///
  /// NOTE: `event_outbox_attention_idx` - (status, created_at DESC) WHERE status
  /// IN ('failed', 'pending') - is created by hand in
  /// 20260909000000_outbox_fan_out_resume_and_recovery. Prisma has no
  /// partial-index syntax. It serves the operator's "what is stuck in this
  /// project?" page.
  @@map("event_outbox")
}

// ===========================================================================
// Delivery
// ===========================================================================

enum DeliveryStatus {
  pending
  scheduled
  queued
  processing
  succeeded
  failed
  retrying
  exhausted
  cancelled
}

/// Materialised fan-out: one row per (event, endpoint) match, each with its own
/// independent retry chain. Written BEFORE any delivery is attempted, so this
/// table is the record of what should be delivered - which is what makes replay
/// and "did finance ever receive this?" answerable.
model Delivery {
  id             String         @id
  eventId        String         @map("event_id")
  endpointId     String         @map("endpoint_id")
  subscriptionId String?        @map("subscription_id")
  organizationId String         @map("organization_id")
  projectId      String         @map("project_id")
  status         DeliveryStatus @default(pending)
  attemptCount   Int            @default(0) @map("attempt_count")
  maxAttempts    Int            @map("max_attempts")
  /// NOT NULL since 20260911000000_next_attempt_at_not_null, defaulted to the
  /// insert time. The claim orders by it, and while it was nullable NULL sorted
  /// FIRST - ahead of every retry that was actually due - so one stray NULL
  /// silently jumped the queue. A terminal row keeps a value too (the worker
  /// writes now() on every terminal transition); it has no scheduling meaning
  /// there, because status alone keeps a terminal row out of the ready set.
  nextAttemptAt  DateTime       @default(now()) @map("next_attempt_at")
  lastAttemptAt  DateTime?      @map("last_attempt_at")
  completedAt    DateTime?      @map("completed_at")
  /// Opt-in serialisation key. Stored from day one; enforcement is deferred
  /// (ADR-0004). Null means unordered.
  orderingKey    String?        @map("ordering_key")
  /// Worker lease. A delivery whose lease has expired is reclaimable, which is
  /// how a worker crash mid-delivery recovers.
  lockedBy       String?        @map("locked_by")
  lockedUntil    DateTime?      @map("locked_until")
  /// Set when this delivery was created by replaying an earlier one. The
  /// original row is never mutated (ARCHITECTURE.md 34).
  replayOfDeliveryId String?    @map("replay_of_delivery_id")
  replayedBy     String?        @map("replayed_by")
  lastError      String?        @map("last_error")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  /// When the retention sweep deleted this delivery's `delivery_attempts` rows.
  /// Null means the attempt history is still here.
  ///
  /// Two horizons, not one: the attempt rows carry the bytes (two header maps
  /// and a truncated response body each) and this row carries the answers, so
  /// the detail is reclaimed sooner than the summary
  /// (services/data-plane/internal/retention). This column is what makes that
  /// possible - deleting from `delivery_attempts` changes nothing the sweep's
  /// candidate query can see, so without a marker every pass would re-select the
  /// same deliveries forever and delete nothing.
  ///
  /// It is also the difference between an honest ledger and a misleading one:
  /// `attempt_count: 5` with an empty attempt list is indistinguishable from
  /// "we never tried" unless something says the detail was pruned.
  attemptsPrunedAt DateTime?    @map("attempts_pruned_at")
  /// W3C `traceparent` of the ROUTER's fan-out span, written in the same
  /// transaction that materialised this row. The worker reads it and links each
  /// attempt to it.
  ///
  /// It is the router's context and not the event's because a delivery is a
  /// SEPARATE RETRY CHAIN from its event: one event becomes N deliveries, each
  /// living and failing independently. Null means tracing was off, or the row
  /// predates it.
  traceContext   String?        @map("trace_context")

  /// Restrict, not Cascade. `delivery_attempts` is append-only and this table is
  /// the answer to "did finance ever receive this?"; a single
  /// `prisma.endpoint.delete()` must not be able to erase months of history.
  /// Endpoint and project removal is a soft delete (`status = 'deleted'`).
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  endpoint Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  attempts DeliveryAttempt[]

  /// The scheduler's claim query. Partial index keeps it small as succeeded
  /// deliveries accumulate.
  @@index([status, nextAttemptAt])
  /// NOTE: `deliveries_event_endpoint_original_key` - a PARTIAL unique index on
  /// (event_id, endpoint_id) WHERE replay_of_delivery_id IS NULL - is created by
  /// hand in migration 20260906010000_review_fixes. Prisma cannot express a
  /// partial unique index, so it is invisible here and to `migrate diff`.
  /// It is the ON CONFLICT arbiter the fan-out router names; without it a
  /// re-run router double-fans-out. Replays are exempt by design.
  @@index([eventId])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([projectId, status, createdAt(sort: Desc)])
  /// The analytics window index (20260908010000_analytics_delivery_window_index).
  /// `status` sits between the two columns an "everything in this project over
  /// this window" query constrains, so the index above cannot serve one:
  /// created_at can never be a boundary condition and the rows never come back
  /// in created_at order. Measured on 1M rows, the difference for the latency
  /// sample at the 30-day ceiling is a 226 ms parallel sequential scan versus a
  /// 0.35 ms index scan that stops at the LIMIT.
  @@index([projectId, createdAt(sort: Desc)])
  /// NOTE: `deliveries_ready_idx` and `deliveries_ready_fifo_idx` - partial
  /// indexes over the claim's ready set - are created by hand in
  /// 20260907000000_handoff_schema_requests. Prisma has no partial-index
  /// syntax. `processing` is in both predicates deliberately: a leased row IS
  /// processing, and internal/queue's claim reclaims expired leases, so
  /// excluding it would put an abandoned delivery outside the index and make a
  /// dead worker's rows recoverable only by a sequential scan.
  ///
  /// `next_attempt_at` is NOT NULL, and it was made so by APPENDING a migration
  /// (20260911000000_next_attempt_at_not_null) rather than by editing the two
  /// earlier files that discuss it. 20260907000000 still says on disk that
  /// "NOT NULL would fail every succeed" - that was true when it was written and
  /// stopped being true when internal/worker's advanceSQL began writing now()
  /// on its terminal branch; Prisma checksums applied migrations, so the stale
  /// sentence stays and the correction lives here and in the new file.
  ///
  /// The same migration REBUILT `deliveries_ready_idx` and
  /// `deliveries_ready_fifo_idx` without `NULLS FIRST` and with `id` appended
  /// as the claim's tiebreaker, because the claim's ORDER BY dropped NULLS FIRST
  /// at the same time and the planner does not treat a NULLS FIRST index as
  /// delivering a NULLS LAST ordering, NOT NULL or not. Both indexes keep their
  /// names, their predicate and their entry in
  /// deployments/ci/expected-schema-drift.txt.
  ///
  /// NOTE: `deliveries_retention_idx` and `deliveries_attempt_pruning_idx` -
  /// partial indexes over the TERMINAL set, ordered by created_at - are created
  /// by hand in 20260909100000_delivery_retention, for the same reason: Prisma
  /// has no partial-index syntax. They serve the two retention sweeps. Neither
  /// is written on the fan-out INSERT (a delivery is inserted 'pending', so it
  /// enters neither index there); both entries are made by the single UPDATE
  /// that takes the delivery terminal.
  @@map("deliveries")
}

enum AttemptStatus {
  success
  failure
  timeout
  error
}

/// Append-only per-attempt history. Never updated after completion.
model DeliveryAttempt {
  id              String        @id
  deliveryId      String        @map("delivery_id")
  attemptNumber   Int           @map("attempt_number")
  startedAt       DateTime      @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  status          AttemptStatus
  httpStatus      Int?          @map("http_status")
  requestHeaders  Json?         @map("request_headers")
  responseHeaders Json?         @map("response_headers")
  /// Truncated to EGRESS_MAX_RESPONSE_BYTES. Larger bodies go to object storage.
  responseBody    String?       @map("response_body")
  responseBodyLocation String?  @map("response_body_location")
  responseSize    Int?          @map("response_size")
  errorCode       String?       @map("error_code")
  errorMessage    String?       @map("error_message")
  durationMs      Int?          @map("duration_ms")
  workerId        String?       @map("worker_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  /// Trace id (32 hex) of the span for THIS attempt, and the seam between the
  /// delivery ledger and the trace backend: the row an operator is already
  /// looking at names the trace of that exact attempt.
  ///
  /// Written ONLY when the span was actually sampled. A trace id for a dropped
  /// span is a link that leads to an empty page, from which an operator
  /// concludes the backend is broken rather than that this attempt was not
  /// recorded - so null honestly means "no trace was kept for this attempt".
  ///
  /// Each attempt has its OWN trace rather than sharing one with the delivery:
  /// attempts are up to an hour apart on different pods, and nothing can hold a
  /// span open across a process restart. The retry chain is reassembled by
  /// querying the backend for webhook.delivery.id, not by the span tree.
  traceId         String?       @map("trace_id")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId])
  @@map("delivery_attempts")
}

// ===========================================================================
// Audit, usage, billing
// ===========================================================================

model AuditLog {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  /// Set when the actor was an API key rather than a user.
  apiKeyId       String?  @map("api_key_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Aggregated asynchronously, never inside the ingest transaction
/// (ARCHITECTURE.md 50).
model UsageRecord {
  id             String   @id
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  /// events_ingested | deliveries | delivery_attempts | bytes_egress | replays
  metric         String
  quantity       BigInt
  /// Start of the aggregation bucket (hourly).
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Replaced in 20260906010000_review_fixes by a NULLS NOT DISTINCT index of
  /// the same name. Org-level rows carry projectId NULL; under the default
  /// NULLS DISTINCT semantics the hourly aggregator's upsert never matched an
  /// existing row and INSERTed a duplicate on every run, so billing summed the
  /// same hour repeatedly and over-billed. Kept here for Prisma's upsert typing.
  @@unique([organizationId, projectId, metric, periodStart])
  @@index([organizationId, periodStart])
  @@map("usage_records")
}

model Plan {
  id                   String   @id
  name                 String
  slug                 String   @unique
  /// Business rules live here, not in the delivery engine (ARCHITECTURE.md 51).
  retentionDays        Int      @map("retention_days")
  maxProjects          Int?     @map("max_projects")
  maxEndpoints         Int?     @map("max_endpoints")
  maxMembers           Int?     @map("max_members")
  includedEventsPerMonth BigInt? @map("included_events_per_month")
  ingestRateLimit      Int?     @map("ingest_rate_limit")
  features             Json?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organizations        Organization[]
  billingSubscriptions BillingSubscription[]

  @@map("plans")
}

enum BillingStatus {
  trialing
  active
  past_due
  canceled
}

model BillingSubscription {
  id                 String        @id
  organizationId     String        @map("organization_id")
  planId             String        @map("plan_id")
  status             BillingStatus @default(trialing)
  provider           String?
  providerCustomerId String?       @map("provider_customer_id")
  providerSubscriptionId String?   @map("provider_subscription_id")
  currentPeriodStart DateTime?     @map("current_period_start")
  currentPeriodEnd   DateTime?     @map("current_period_end")
  cancelAt           DateTime?     @map("cancel_at")
  canceledAt         DateTime?     @map("canceled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@map("billing_subscriptions")
}
