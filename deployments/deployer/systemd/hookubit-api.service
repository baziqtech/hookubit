# HookuBit control API.
#
# This unit replaces the one in apps/docs/self-hosting/09-bare-metal-ubuntu.md §7.
# The only substantive change is the path: the guide runs /opt/hookubit/src,
# which a Deployer release layout never writes to. Everything here points at
# /opt/hookubit/current, the symlink the deploy swaps atomically, so a restart
# picks up the new release and `dep rollback` actually rolls back.
#
# Install once, by hand, as root — the deploy user's sudo rights stop at
# start/stop/restart and deliberately do not include writing to /etc:
#
#   sudo install -m 0644 -o root -g root hookubit-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable hookubit-api
#
# If deploy_path in hosts.yml is not /opt/hookubit, change both together:
# hookubit:systemd:check refuses to deploy when this unit does not reference
# <deploy_path>/current, because with a fixed path the atomic swap changes
# nothing and the deploy reports success while the old code keeps running.

[Unit]
Description=HookuBit control API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hookubit
Group=hookubit
WorkingDirectory=/opt/hookubit/current/apps/control-api
# CONFIGURATION IS TWO FILES, AND THE ORDER IS THE WHOLE POINT.
#
#   /opt/hookubit/shared/.env                    the nine variables BOTH planes read
#   /opt/hookubit/shared/apps/control-api/.env   this service's own
#
# A LATER EnvironmentFile= WINS in systemd, so the common file goes FIRST and this
# service's own second. @nestjs/config resolves it the same way round from the other
# end - envFilePath is ['.env', '../../.env'] against this WorkingDirectory, and
# EARLIER entries win there - so both parsers agree that service-specific beats common.
# If they disagreed, one file would mean different things to the process and to the unit
# that starts it, and the symptom would be a value nobody can find in either file.
#
# NO `-` PREFIX, deliberately. `-EnvironmentFile=` tolerates a missing file, and there
# is no state of this system in which running without one of these is correct. Much of
# the platform's configuration has a safe default - LOG_LEVEL, every EGRESS_*, the
# breaker thresholds - so a tolerated-missing file does not fail cleanly; it starts
# something that is configured by accident. Without the dash, a start fails BEFORE
# ExecStart with `Failed to load environment files: No such file or directory` naming
# the path, which is the one message an operator can act on. These units are `enable`d
# and not started until the first deploy, so the only way to meet it is a reboot in
# between - exactly when "you have not deployed yet" is the right answer.
#
# SHARED PATHS, NOT RELEASE PATHS. <release>/.env and <release>/apps/control-api/.env
# are symlinks to these same two files, but they exist only for whichever release is
# current - so a unit that read them through current/ would depend on the symlink swap
# having finished. PID 1 reads these as root before privileges are dropped, so
# ProtectSystem= and ReadOnlyPaths= below do not apply to them. The service user's own
# access matters for a different reason: @nestjs/config does existsSync() and then
# readFileSync() on those two symlinks, and an EACCES there is a control API that does
# not boot. That is what the 0640 mode and the hookubit group in the README are for.
EnvironmentFile=/opt/hookubit/shared/.env
EnvironmentFile=/opt/hookubit/shared/apps/control-api/.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
# Above the Nest shutdown path, so in-flight requests finish instead of being
# killed mid-response.
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The release tree is read-only to the service: it is written by the deploy
# user, not by the process that runs it. Nothing under /opt/hookubit needs to be
# writable at runtime, so nothing is.
ReadOnlyPaths=/opt/hookubit

[Install]
WantedBy=multi-user.target
