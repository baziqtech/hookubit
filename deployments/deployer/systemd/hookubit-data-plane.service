# HookuBit data plane — ingest, router, scheduler, worker in one process.
#
# This unit replaces the one in apps/docs/self-hosting/09-bare-metal-ubuntu.md §7.
# The guide's ExecStart is /opt/hookubit/bin/webhookd, a fixed path outside any
# release. The deploy builds the binary into the release
# (<release>/bin/webhookd) so the symlink swap and `dep rollback` carry the
# binary with the code that matches it — a Go binary and a schema are a matched
# pair, and rolling one without the other is how the fan_out_cursor stall
# happens.
#
# Install once, by hand, as root:
#
#   sudo install -m 0644 -o root -g root hookubit-data-plane.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable hookubit-data-plane
#
# Do NOT add the deploy to an `enable --now`: the deploy stops this unit across
# the migration on purpose, and systemd must not race it back up.

[Unit]
Description=HookuBit data plane (ingest, router, scheduler, worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hookubit
Group=hookubit
WorkingDirectory=/opt/hookubit/current
# CONFIGURATION IS TWO FILES, AND THE ORDER IS THE WHOLE POINT.
#
#   /opt/hookubit/shared/.env                       the nine variables BOTH planes read
#   /opt/hookubit/shared/services/data-plane/.env   this service's own
#
# A LATER EnvironmentFile= WINS in systemd, so the common file goes FIRST and this
# service's own second. The Go binary does not read either file - it reads the process
# environment, and this is what fills it. The order still has to match the control
# plane's (@nestjs/config, where EARLIER envFilePath entries win), because the common
# file is the SAME file for both planes and an ENCRYPTION_KEY that resolves differently
# in the two is a worker that cannot decrypt what the control API wrote.
#
# NO `-` PREFIX, deliberately. `-EnvironmentFile=` tolerates a missing file, and there
# is no state of this system in which running without one of these is correct. Much of
# the platform's configuration has a safe default - LOG_LEVEL, every EGRESS_*, the
# breaker thresholds - so a tolerated-missing file does not fail cleanly; it starts
# something that is configured by accident. Without the dash, a start fails BEFORE
# ExecStart with `Failed to load environment files: No such file or directory` naming
# the path, which is the one message an operator can act on. These units are `enable`d
# and not started until the first deploy, so the only way to meet it is a reboot in
# between - exactly when "you have not deployed yet" is the right answer.
#
# SHARED PATHS, NOT RELEASE PATHS. <release>/services/data-plane/.env is a symlink to
# the same file, but it exists only for whichever release is current - so a unit that
# read it through current/ would depend on the symlink swap having finished. PID 1 reads
# these as root before privileges are dropped, so ProtectSystem= and ReadOnlyPaths=
# below do not apply to them, and this process never opens either file itself.
EnvironmentFile=/opt/hookubit/shared/.env
EnvironmentFile=/opt/hookubit/shared/services/data-plane/.env
ExecStart=/opt/hookubit/current/bin/webhookd all
Restart=on-failure
RestartSec=5
# webhookd drains for 25s in process, and one outbound attempt can take a full
# EGRESS_TOTAL_TIMEOUT_MS (30s) on top. systemd's 90s default is fine; this is
# explicit so nobody "tidies" it down to 10.
TimeoutStopSec=90

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Written by the deploy user, executed by the service user. The process cannot
# rewrite the binary it is running.
ReadOnlyPaths=/opt/hookubit

[Install]
WantedBy=multi-user.target
